# Copy to .env beside manage.py and fill in. .env is gitignored; this file is
# the template that is committed. Real environment variables override it.

# --- Required in production -------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# The app refuses to start without this when DEBUG is off.
SECRET_KEY=

# Hostnames and IPs the app answers to, comma separated. No scheme, no port.
ALLOWED_HOSTS=localhost,127.0.0.1

# Same addresses but WITH the scheme, comma separated. Without these, every
# form submitted from anything other than localhost fails as a CSRF error.
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# --- Development only -------------------------------------------------------

# Leave unset (or 0) in production. Off means no tracebacks in the browser,
# and no static files served by Django -- run collectstatic instead.
DEBUG=1

# --- Optional ---------------------------------------------------------------

# The shop's own timezone, so history reads in local time. Stored timestamps
# stay UTC either way.
TIME_ZONE=Europe/Athens

# Turn on only once Apache is actually serving HTTPS. Setting it beforehand
# does not warn -- it silently stops anyone logging in.
HTTPS=0

# sqlite (default) or mysql, for XAMPP's MariaDB.
DB_ENGINE=sqlite
# DB_NAME=mentor
# DB_USER=mentor
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
